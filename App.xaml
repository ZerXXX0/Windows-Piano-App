<Application x:Class="PianoApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Piano key colors -->
        <SolidColorBrush x:Key="WhiteKeyBrush" Color="#FFFFF8F0"/>
        <SolidColorBrush x:Key="BlackKeyBrush" Color="#FF1A1A1A"/>
        <SolidColorBrush x:Key="WhiteKeyPressedBrush" Color="#FF4CAF50"/>
        <SolidColorBrush x:Key="BlackKeyPressedBrush" Color="#FF66BB6A"/>
        <SolidColorBrush x:Key="WhiteKeySustainedBrush" Color="#FFFFC107"/>
        <SolidColorBrush x:Key="BlackKeySustainedBrush" Color="#FFFFCA28"/>
        <SolidColorBrush x:Key="KeyBorderBrush" Color="#FF333333"/>
    </Application.Resources>
</Application>
